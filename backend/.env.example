# Generate a strong random production secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_before_deploying
JWT_EXPIRES_IN=1h
PORT=4000

# MySQL (XAMPP / Local or Remote) Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ri_desk

# Comma-separated list of live browser domains allowed to call this backend API
ALLOWED_ORIGINS=https://desk.yourdomain.com,https://your-php-site.com,http://localhost:5173
